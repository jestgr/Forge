{
  "name": "forge",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Forge workout tracker: plain HTML/CSS/JS PWA. The app/ folder is served as-is (no build step).",
  "scripts": {
    "dev": "python3 -m http.server 3010 --bind 0.0.0.0 --directory app",
    "lint": "tsc -p tsconfig.json",
    "test": "node --test tests/",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2"
  }
}
