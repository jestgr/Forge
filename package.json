{
  "name": "forge",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Forge workout tracker: plain HTML/CSS/JS PWA. The app/ folder is served as-is (no build step).",
  "scripts": {
    "dev": "python3 -m http.server 3010 --bind 0.0.0.0 --directory app",
    "lint": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-health": "^8.11.12"
  }
}
